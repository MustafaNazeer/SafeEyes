# ML artifacts and data (too large / not source)
# Anchored to the repo root so source packages named data/ stay tracked.
/data/
/datasets/
/features/
# DMD is CC BY-NC-ND: annotation derived split manifests are not redistributed.
# Regenerate them deterministically with the documented build command (seed 0).
/splits/dmd-distraction/
/splits/dmd-gaze/
/splits/yawdd/
*.npy
*.mp4
*.avi
*.mov
# Local model build output: checkpoints, edge artifacts, and their metric traces.
# The canonical reported metrics live under docs/ml/, not here.
/models/
*.pt
*.pth
*.onnx
*.onnx.data
*.tflite
runs/
wandb/
mlruns/

# uv lockfile: the documented workflow is pip with pyproject.toml, so this is incidental.
uv.lock

# Build / packaging
build/
dist/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
